# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Server
PORT=3000
NODE_ENV=development

# JWT — use a long random string (e.g. openssl rand -base64 48)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS — set to deployed frontend URL in production (leave unset in development)
# CORS_ORIGIN=https://your-frontend.onrender.com

# 2. Create a project ? APIs & Services ? Credentials
# 3. Create OAuth 2.0 Client ID (Web application type)
# 4. Add Authorised JavaScript origins: http://localhost:5173 (dev) + your production URL
# 5. Copy the Client ID below (the secret is only needed server-side)